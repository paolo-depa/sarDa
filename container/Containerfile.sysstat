# Parser image for sarDa: the sysstat package delivered by the SUSE base image.
#
# SLE 16 SP1 (BCI 16.1) provides sysstat 12.7.9. sarDa checks every SA file's
# magic header and refuses files written by a *newer* sysstat, because sadf
# then returns no data at all instead of failing (ADR 0007). Put an image with
# a newer sysstat behind --sadf-image when you need to read such files.
#
# A release publishes this image to ghcr.io/<owner>/sarda-sysstat, which is
# sarda's default. To build it yourself on a machine with network access:
#
#   sarda prepare --build --sadf-image localhost/sarda-sysstat:latest
#   sarda --sadf-image localhost/sarda-sysstat:latest <SA files>
FROM registry.suse.com/bci/bci-base:16.1
RUN zypper --non-interactive install --no-recommends sysstat \
    && zypper clean --all
